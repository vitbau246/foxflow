# FoxFlow configuration (copy to .env to override defaults)

# Interface language: en (default) or vi
FOXFLOW_LANG=en

# Profile storage file
FOXFLOW_PROFILES_FILE=profiles.json

# Browser data directory (one sub-folder per profile, holds cookies + fingerprint)
FOXFLOW_DATA_DIR=camoufox_data

# Log directory
FOXFLOW_LOG_DIR=logs

# Log level (DEBUG, INFO, WARNING, ERROR)
FOXFLOW_LOG_LEVEL=INFO

# Proxy check timeout in seconds
FOXFLOW_PROXY_TIMEOUT=10

# Seconds the launch API waits for the browser to be ready
FOXFLOW_LAUNCH_TIMEOUT=90

# Run browsers hidden: true, false or virtual (Linux + Xvfb). Server mode defaults to true.
# FOXFLOW_HEADLESS=false

# Reopen the tabs a profile had open when it was last stopped (default true).
# FOXFLOW_RESTORE_TABS=true

# Recorded workflows, one JSON file each. They hold what was typed while recording, passwords included.
# FOXFLOW_WORKFLOWS_DIR=workflows

# Optional AI text for workflow "ai" steps, through an OpenAI-compatible API. Off until a
# key is set (here, or in the app's AI settings, which saves it to ai_settings.json).
# Prompts and the page text they include are sent to that service.
# FOXFLOW_OPENAI_API_KEY=
# FOXFLOW_OPENAI_BASE_URL=https://api.openai.com/v1
# FOXFLOW_OPENAI_MODEL=gpt-4o-mini

# Proxy for FoxFlow's own internet requests: the AI API, the Chrome engine and GeoIP
# downloads, and the exit-IP / Check IP lookups of profiles that have no proxy of their own.
# Set it when this machine reaches the internet through a proxy (company network).
# Not set = everything goes direct; the system proxy and HTTP(S)_PROXY are ignored.
# Browsers are not affected: each profile uses its own proxy setting.
# FOXFLOW_HTTP_PROXY=http://host:port
# FOXFLOW_HTTP_PROXY=http://user:pass@host:port

# Token for the API, web panel and MCP. Required when API_HOST is not 127.0.0.1.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# FOXFLOW_API_TOKEN=

# Local API settings
FOXFLOW_API_HOST=127.0.0.1
FOXFLOW_API_PORT=8000
